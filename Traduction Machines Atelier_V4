// ==UserScript==
// @name         Traduction Machines Atelier_V4
// @match        *://*/*
// @grant        unsafeWindow
// @run-at       document-idle
// @inject-into  page
// ==/UserScript==
// action: remplace nom machines

(function () {

    'use strict';

    // =========================
    // ADRESSES OÙ LE SCRIPT EST DÉSACTIVÉ
    // =========================

    const adressesExclues = [

        // URL exacte
        'https://example.com/',

        // Domaine entier
        'http://sgsrv67.tiretech.contiwan.com',
        'https://sgtmsrv41.tiremes.contiwan.com',

        // Mot présent dans l'URL
        '/admin/',

        // Autre exemple
        'example.org'

    ];

    function estAdresseExclue() {

        const url = window.location.href;

        return adressesExclues.some(function (adresse) {

            return url.includes(adresse);

        });

    }

    // Si l'adresse actuelle est exclue,
    // on arrête complètement le script.
    if (estAdresseExclue()) {

        console.log(
            '[Traduction Machines Atelier4] DÉSACTIVÉ sur cette adresse :',
            window.location.href
        );

        return;
    }


    // =========================
    // CORRESPONDANCE
    // =========================

    const traductions = {};

    const lettres = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

    for (let i = 0; i < lettres.length; i++) {

        const lettre = lettres[i];
        const rangee = i + 1;

        for (let n = 1; n <= 9; n++) {

            traductions[`CU${lettre}${n}G`] = `${rangee}/${n}G`;
            traductions[`CU${lettre}${n}D`] = `${rangee}/${n}D`;

        }
    }


    // =========================
    // TRAITEMENT D'UN TEXT NODE
    // =========================

    function traiterTextNode(node) {

        if (!node || node.nodeType !== Node.TEXT_NODE) {
            return;
        }

        const texte = node.nodeValue;

        if (!texte) {
            return;
        }

        const parent = node.parentElement;

        if (!parent) {
            return;
        }

        // Ne pas toucher aux zones sensibles
        const tag = parent.tagName;

        if (
            tag === 'SCRIPT' ||
            tag === 'STYLE' ||
            tag === 'NOSCRIPT' ||
            tag === 'TEXTAREA' ||
            tag === 'INPUT'
        ) {
            return;
        }

        // Recherche tous les codes :
        // CUA1G(1/1G)
        // CUB5D(2/5D)(2/5D)
        // CUZ9G(26/9G)(26/9G)
        const regex = /CU[A-Z][1-9][GD]/g;

        const nouveauTexte = texte.replace(
            regex,
            function (code) {

                return traductions[code] || code;

            }
        );

        // Ne modifie le nœud que si quelque chose a changé
        if (nouveauTexte !== texte) {

            node.nodeValue = nouveauTexte;

        }
    }


    // =========================
    // SCAN
    // =========================

    function scanner(element) {

        if (!element) {
            return;
        }

        const walker = document.createTreeWalker(
            element,
            NodeFilter.SHOW_TEXT
        );

        const nodes = [];

        let node;

        while ((node = walker.nextNode())) {

            nodes.push(node);

        }

        nodes.forEach(function (node) {

            traiterTextNode(node);

        });

    }


    // =========================
    // LANCEMENT
    // =========================

    function lancer() {

        if (!document.body) {
            return;
        }

        scanner(document.body);

    }

    lancer();


    // =========================
    // MUTATION OBSERVER
    // =========================

    const observer = new MutationObserver(
        function (mutations) {

            mutations.forEach(function (mutation) {

                mutation.addedNodes.forEach(function (node) {

                    if (
                        node.nodeType === Node.ELEMENT_NODE
                    ) {

                        scanner(node);

                    }

                    else if (
                        node.nodeType === Node.TEXT_NODE
                    ) {

                        traiterTextNode(node);

                    }

                });

            });

        }
    );

    observer.observe(document.body, {

        childList: true,
        subtree: true

    });


    // =========================
    // SURVEILLANCE NAVIGATION
    // =========================

    const ancienPushState = history.pushState;

    history.pushState = function () {

        const resultat =
            ancienPushState.apply(
                this,
                arguments
            );

        setTimeout(lancer, 300);
        setTimeout(lancer, 1000);
        setTimeout(lancer, 2000);

        return resultat;

    };


    const ancienReplaceState = history.replaceState;

    history.replaceState = function () {

        const resultat =
            ancienReplaceState.apply(
                this,
                arguments
            );

        setTimeout(lancer, 300);
        setTimeout(lancer, 1000);
        setTimeout(lancer, 2000);

        return resultat;

    };


    window.addEventListener(
        'popstate',
        function () {

            setTimeout(lancer, 300);
            setTimeout(lancer, 1000);
            setTimeout(lancer, 2000);

        }
    );


    // =========================
    // FILET DE SÉCURITÉ
    // =========================

    setInterval(function () {

        lancer();

    }, 3000);


    // =========================
    // CONFIRMATION
    // =========================

    console.log(
        '[Traduction Machines Atelier4] ACTIVE'
    );

})();
