// ==UserScript==
// @name         Traduction Machines Atelier
// @match        *://*/*
// @grant        unsafeWindow
// @run-at       document-idle
// @inject-into  page
// ==/UserScript==

(function () {

    'use strict';

    // =========================
    // TABLE CORRESPONDANCE
    // =========================

    const traductions = {};

    const lettres = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

    lettres.forEach((lettre, index) => {

        const rangee = index + 1;

        for (let i = 1; i <= 9; i++) {

            traductions[`CU${lettre}${i}G`] = `${rangee}/${i}G`;
            traductions[`CU${lettre}${i}D`] = `${rangee}/${i}D`;
        }
    });

    // =========================
    // TRAITEMENT TEXTE
    // =========================

    function traiterTextNode(node) {

        if (!node || node.nodeType !== Node.TEXT_NODE) {
            return;
        }

        const texte = node.nodeValue;

        if (!texte) return;

        for (const code in traductions) {

            if (texte.includes(code)) {

                const parent = node.parentNode;

                if (!parent) return;

                // Evite double traduction
                if (parent.dataset.traduit) return;

                const fragment = document.createDocumentFragment();

                const parties = texte.split(code);

                parties.forEach((partie, index) => {

                    fragment.appendChild(
                        document.createTextNode(partie)
                    );

                    if (index < parties.length - 1) {

                        // Texte original
                        fragment.appendChild(
                            document.createTextNode(code)
                        );

                        // Traduction
                        const badge = document.createElement('span');

                        badge.textContent =
                            ` (${traductions[code]})`;

                        badge.style.background = '#ff9800';
                        badge.style.color = 'black';
                        badge.style.fontWeight = 'bold';
                        badge.style.padding = '2px 6px';
                        badge.style.borderRadius = '4px';
                        badge.style.marginLeft = '4px';

                        fragment.appendChild(badge);
                    }
                });

                parent.dataset.traduit = "1";

                parent.replaceChild(fragment, node);

                return;
            }
        }
    }

    // =========================
    // SCAN PAGE
    // =========================

    function scanner(node) {

        if (!node) return;

        if (node.nodeType === Node.TEXT_NODE) {

            traiterTextNode(node);
        }

        else {

            node.childNodes.forEach(scanner);
        }
    }

    // =========================
    // LANCEMENT
    // =========================

    function lancer() {

        scanner(document.body);
    }

    lancer();

    // =========================
    // SURVEILLANCE TEMPS REEL
    // =========================

    const observer = new MutationObserver((mutations) => {

        mutations.forEach((mutation) => {

            mutation.addedNodes.forEach((node) => {

                scanner(node);
            });
        });
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

    console.log("TRADUCTION ACTIVE");

})();
