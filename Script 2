// ==UserScript==
// @name         Traduction Machines Atelier
// @match        *://*/*
// @grant        unsafeWindow
// @run-at       document-idle
// @inject-into  page
// ==/UserScript==

(function () {

    'use strict';

    // =========================
    // CORRESPONDANCES
    // =========================

    const traductions = {};

    const lettres = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

    lettres.forEach((lettre, index) => {

        const rangee = index + 1;

        for (let i = 1; i <= 9; i++) {

            traductions[`CU${lettre}${i}G`] = `${rangee}/${i}G`;
            traductions[`CU${lettre}${i}D`] = `${rangee}/${i}D`;
        }
    });

    // =========================
    // TRAITEMENT
    // =========================

    function remplacerDansElement(element) {

        if (!element) return;

        // Evite retraitement
        if (element.dataset.traduit) return;

        let html = element.innerHTML;

        let modifie = false;

        for (const code in traductions) {

            const regex = new RegExp(`\\b${code}\\b`, 'g');

            if (regex.test(html)) {

                modifie = true;

                html = html.replace(
                    regex,
                    `${code}
                    <span style="
                        background:#ff9800;
                        color:black;
                        font-weight:bold;
                        padding:2px 6px;
                        border-radius:4px;
                        margin-left:4px;
                        display:inline-block;
                    ">
                        (${traductions[code]})
                    </span>`
                );
            }
        }

        if (modifie) {

            element.innerHTML = html;
            element.dataset.traduit = "1";
        }
    }

    // =========================
    // SCAN COMPLET
    // =========================

    function scanner() {

        const elements = document.querySelectorAll('div, span, td, p, label');

        elements.forEach(remplacerDansElement);
    }

    // =========================
    // LANCEMENT
    // =========================

    setInterval(scanner, 2000);

    scanner();

    console.log("TRADUCTION ACTIVE");

})();
