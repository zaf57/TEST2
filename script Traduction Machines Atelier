// ==UserScript==
// @name         Traduction Machines Atelier
// @match        http*://*/*
// @match        *://url du site/*
// @match        *://*/*
// @grant        none
// ==/UserScript==

(function() {

    'use strict';

    const traductions = {};
    const lettres = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

    lettres.forEach((lettre, index) => {
    const rangee = index + 1;
    for(let i = 1; i <= 9; i++) {
            traductions[`CU${lettre}${i}G`] = `${rangee}/${i}G`;
            traductions[`CU${lettre}${i}D`] = `${rangee}/${i}D`;
        }
    });

    let html = document.body.innerHTML;

    for(const code in traductions) {

        html = html.replaceAll(
            code,
            `${code} <span style="
                color:#ff9800;
                font-weight:bold;
            ">(${traductions[code]})</span>`
        );
    }

    document.body.innerHTML = html;

})();
