// ==UserScript==
// @name         Traduction Machines Atelier mdr
// @match        *://*/*
// @grant        unsafeWindow
// @run-at       document-idle
// @inject-into  page
// ==/UserScript==

(function () {

    'use strict';

    // =========================
    // CORRESPONDANCE
    // =========================

    const traductions = {};

    const lettres = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

    for (let i = 0; i < lettres.length; i++) {

        const lettre = lettres[i];
        const rangee = i + 1;

        for (let n = 1; n <= 9; n++) {

            traductions[`CU${lettre}${n}G`] = `${rangee}/${n}G`;
            traductions[`CU${lettre}${n}D`] = `${rangee}/${n}D`;

        }
    }

    // =========================
    // STYLE DES BULLES
    // =========================

    const style = document.createElement('style');

    style.textContent = `
        .tm-inline {
            display: inline-block;
            margin-left: 7px;
            padding: 1px 8px;
            border-radius: 999px;
            background: rgba(12, 12, 16, 0.82);
            box-shadow:
                0 2px 8px rgba(0, 0, 0, 0.35),
                0 0 10px rgba(255, 255, 255, 0.04);
            vertical-align: middle;
            line-height: 1.4;
            cursor: grab;
            user-select: none;
            touch-action: none;
        }

        .tm-inline .tm-texte {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 0.85em;
            background: linear-gradient(
                90deg,
                #ff5f6d, #ffc371, #f9f871,
                #6dffb5, #5ad1ff, #a78bfa,
