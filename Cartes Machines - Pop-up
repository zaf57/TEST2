    racine.appendChild(style);

    const conteneur = el('div');
    racine.appendChild(conteneur);

    // =========================
    // ÉTAT
    // =========================

    let donnees = null;
    let erreur = '';
    let ouvert = false;            // fermée (bulle) à l'ouverture de la page
    let vue = 'derniere';          // 'derniere' | 'liste' | 'detail'
    let detailCle = null;
    let recherche = '';
    let confirmation = null;       // { cle, nom, occupe, erreur } pendant une suppression
    let notification = '';

    function dejaVue(carte) {
        return carte && carte.date && GM_getValue('derniereVue', '') >= carte.date;
    }

    function marquerVue(carte) {
        if (carte && carte.date) GM_setValue('derniereVue', carte.date);
    }

    // =========================
    // AFFICHAGE
    // =========================

    function ficheCarte(carte, nouvelle) {

        const corps = el('div', 'corps');

        if (nouvelle) corps.appendChild(el('div', 'nouveau', 'NOUVELLE CARTE'));

        corps.appendChild(el('p', 'presse', carte.presse || carte.cle || '—'));
        corps.appendChild(el('div', 'quand', 'Photo ' + ilYA(carte.date)));

        [
            ['Specification Code', carte.spec],
            ['BladderCode', carte.bladderCode],
            ['BladderType', carte.bladderType],
            ['Date bladder', carte.bladderDate]
        ].forEach(function (l) {
            const ligne = el('div', 'ligne');
            ligne.appendChild(el('span', '', l[0]));
            ligne.appendChild(el('b', '', l[1] || '—'));
            corps.appendChild(ligne);
        });

        return corps;
    }

    function rendre() {

        conteneur.innerHTML = '';

        const derniere = derniereCarte(donnees);

        // --- Pop-up fermée : petite bulle ----------------------------
        if (!ouvert) {
            const bulle = el('button', 'bulle', '🏭');
            bulle.title = 'Cartes machines';
            if (derniere && !dejaVue(derniere)) bulle.appendChild(el('span', 'point'));
            bulle.addEventListener('click', function () {
                ouvert = true;
                vue = 'derniere';
                rendre();
            });
            conteneur.appendChild(bulle);
            return;
        }

        const pop = el('div', 'pop');

        // --- En-tête ---------------------------------------------------
        const entete = el('div', 'entete');
        entete.appendChild(el('b', '', vue === 'liste' ? '🏭 TOUTES LES PRESSES' : '🏭 CARTE MACHINE'));

        const fermer = el('button', '', '×');
        fermer.title = 'Fermer';
        fermer.addEventListener('click', function () {
            marquerVue(derniere);
            ouvert = false;
            rendre();
        });
        entete.appendChild(fermer);
        pop.appendChild(entete);

        // --- Confirmation de suppression (remplace le contenu) ---------
        if (confirmation) {
            pop.appendChild(rendreConfirmation());
            conteneur.appendChild(pop);
            return;
        }

        // --- Contenu ---------------------------------------------------
        if (erreur && !donnees) {

            const corps = el('div', 'corps');
            corps.appendChild(el('div', 'erreur', 'Impossible de lire les données : ' + erreur));
            pop.appendChild(corps);

        } else if (!donnees) {

            const corps = el('div', 'corps');
            corps.appendChild(el('div', 'vide', 'Chargement…'));
            pop.appendChild(corps);

        } else if (vue === 'liste') {

            pop.appendChild(rendreListe());

        } else if (vue === 'detail' && donnees.presses && donnees.presses[detailCle]) {

            pop.appendChild(ficheCarte(Object.assign({ cle: detailCle }, donnees.presses[detailCle]), false));

        } else if (derniere) {

            pop.appendChild(ficheCarte(derniere, !dejaVue(derniere)));

        } else {

            const corps = el('div', 'corps');
            corps.appendChild(el('div', 'vide', 'Aucune carte enregistrée pour l\'instant.'));
            pop.appendChild(corps);
        }

        // --- Boutons ---------------------------------------------------
        const actions = el('div', 'actions');

        if (vue === 'derniere') {
            const btnListe = el('button', '', '📋 Toutes');
            btnListe.addEventListener('click', function () { vue = 'liste'; rendre(); });
            actions.appendChild(btnListe);
        } else if (vue === 'detail') {
            const btnRetour = el('button', '', '← Liste');
            btnRetour.addEventListener('click', function () { vue = 'liste'; rendre(); });
            actions.appendChild(btnRetour);

            const btnSuppr = el('button', 'danger', '🗑 Supprimer');
            btnSuppr.addEventListener('click', function () { demanderSuppression(detailCle); });
            actions.appendChild(btnSuppr);
        } else {
            const btnRetour = el('button', '', '← Dernière');
            btnRetour.addEventListener('click', function () { vue = 'derniere'; rendre(); });
            actions.appendChild(btnRetour);
        }

        const btnMaj = el('button', '', '🔄 Actualiser');
        btnMaj.addEventListener('click', function () {
            btnMaj.textContent = '⏳…';
            actualiser();
        });
        actions.appendChild(btnMaj);

        pop.appendChild(actions);

        if (notification) pop.appendChild(el('div', 'notif', '✓ ' + notification));

        conteneur.appendChild(pop);
    }

    function rendreConfirmation() {

        const c = confirmation;
        const bloc = el('div', 'confirm');

        const icone = el('div', 'confirm-icone', '🗑');
        bloc.appendChild(icone);
        bloc.appendChild(el('div', 'confirm-titre', 'Supprimer ' + c.nom + ' ?'));
        bloc.appendChild(el('div', 'confirm-texte', 'La presse sera retirée de la liste et de l\'historique.'));

        // Pas encore de token : on le demande ici, une seule fois.
        let champ = null;
        if (!tokenEcriture()) {
            const label = el('label', 'confirm-label', 'Token GitHub (demandé une seule fois)');
            champ = el('input', 'recherche');
            champ.type = 'password';
            champ.placeholder = 'github_pat_…';
            champ.autocomplete = 'off';
            label.appendChild(champ);
            bloc.appendChild(label);
            champ.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter') confirmerSuppression(champ.value);
            });
            setTimeout(function () { champ.focus(); }, 0);
        }

        if (c.erreur) bloc.appendChild(el('div', 'confirm-erreur', c.erreur));

        const actions = el('div', 'actions');
        actions.style.padding = '0';

        const annuler = el('button', '', 'Annuler');
        annuler.disabled = c.occupe;
        annuler.addEventListener('click', function () { confirmation = null; rendre(); });

        const valider = el('button', 'danger plein', c.occupe ? 'Suppression…' : 'Supprimer');
        valider.disabled = c.occupe;
        valider.addEventListener('click', function () { confirmerSuppression(champ ? champ.value : ''); });

        actions.append(annuler, valider);
        bloc.appendChild(actions);

        return bloc;
    }

    function rendreListe() {

        const corps = el('div', 'corps');

        const champ = el('input', 'recherche');
        champ.placeholder = 'Rechercher (presse, spec, bladder…)';
        champ.value = recherche;
        corps.appendChild(champ);

        const liste = el('div', 'liste');
        corps.appendChild(liste);

        function remplir() {

            liste.innerHTML = '';

            const q = recherche.toLowerCase().replace(/\s+/g, '');

            const cartes = Object.keys(donnees.presses || {})
                .map(function (cle) { return Object.assign({ cle: cle }, donnees.presses[cle]); })
                .filter(function (c) {
                    if (!q) return true;
                    return [c.cle, c.presse, c.spec, c.bladderCode, c.bladderType, c.bladderDate]
                        .join(' ').toLowerCase().replace(/\s+/g, '').includes(q);
                })
                .sort(function (a, b) {
                    return (a.cle || '').localeCompare(b.cle || '', 'fr', { numeric: true });
                });

            if (!cartes.length) {
                liste.appendChild(el('div', 'vide',
                    Object.keys(donnees.presses || {}).length ? 'Aucun résultat.' : 'Aucune presse enregistrée.'));
                return;
            }

            cartes.forEach(function (c) {

                const item = el('div', 'item');

                const texte = el('div', 'texte');
                texte.appendChild(el('b', '', c.presse || c.cle));
                texte.appendChild(el('em', '', ilYA(c.date)));
                texte.appendChild(el('small', '',
                    [c.spec, c.bladderCode, c.bladderType, c.bladderDate].filter(Boolean).join(' · ') || '—'));
                item.appendChild(texte);

                const poubelle = el('button', 'poubelle', '🗑');
                poubelle.title = 'Supprimer cette presse';
                poubelle.addEventListener('click', function (ev) {
                    ev.stopPropagation();
                    demanderSuppression(c.cle);
                });
                item.appendChild(poubelle);

                item.addEventListener('click', function () {
                    vue = 'detail';
                    detailCle = c.cle;
                    rendre();
                });

                liste.appendChild(item);
            });
        }

        champ.addEventListener('input', function () {
            recherche = champ.value;
            remplir();
        });

        remplir();
        setTimeout(function () { champ.focus(); }, 0);

        return corps;
    }

    // =========================
    // ACTUALISATION
    // =========================

    async function actualiser() {

        try {
            donnees = await chargerDonnees();
            erreur = '';
        } catch (e) {
            erreur = e.message;
            console.error('[Cartes Machines]', e);
        }

        // Nouvelle carte : la pop-up reste fermée, la bulle affiche
        // simplement un point orange (voir rendre()).

        // Ne pas effacer ce que l'utilisateur tape dans la recherche.
        const rechercheActive = vue === 'liste' && racine.activeElement &&
            racine.activeElement.classList.contains('recherche');

        if (!rechercheActive) rendre();
    }

    rendre();
    actualiser();

    setInterval(actualiser, INTERVALLE_SECONDES * 1000);

    console.log('[Cartes Machines] ACTIF');

})();
