// ==UserScript==
// @name         Cartes Machines - Pop-up
// @namespace    cartes-machines
// @version      1.6
// @description  Affiche dans une pop-up les infos des cartes machines photographiées avec l'app.
// @match        *://*/*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      api.github.com
// @connect      raw.githubusercontent.com
// @run-at       document-idle
// @noframes
// ==/UserScript==

(function () {

    'use strict';

    // =========================
    // RÉGLAGES — À COMPLÉTER
    // =========================

    const GITHUB = {
        compte: 'zaf57',               // votre nom d'utilisateur GitHub
        depot: 'cartes-machines',      // nom du dépôt
        branche: 'main',
        fichier: 'presses.json',
        token: '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'                      // facultatif : collez ici votre token (github_pat_…)
                                       // pour ne pas avoir à le saisir à la 1re suppression
    };

    // Adresses où la pop-up doit apparaître (un morceau d'URL suffit).
    // Liste vide = la pop-up apparaît sur TOUS les sites.
    const ADRESSES_ACTIVES = [
        // 'sgsrv67.tiretech.contiwan.com',
    ];

    // Vérification d'une nouvelle carte toutes les X secondes.
    const INTERVALLE_SECONDES = 90;

    // =========================
    // FILTRE D'ADRESSE
    // =========================

    function estAdresseActive() {

        if (ADRESSES_ACTIVES.length === 0) return true;

        const url = window.location.href;

        return ADRESSES_ACTIVES.some(function (adresse) {
            return url.includes(adresse);
        });
    }

    if (!estAdresseActive()) return;

    // =========================
    // LECTURE DU FICHIER SUR GITHUB
    // =========================

    function requete(url, entetes) {

        return new Promise(function (resolve, reject) {

            GM_xmlhttpRequest({
                method: 'GET',
                url: url,
                headers: entetes,
                timeout: 15000,
                onload: function (r) {
                    if (r.status >= 200 && r.status < 300) resolve(r.responseText);
                    else reject(new Error('HTTP ' + r.status));
                },
                onerror: function () { reject(new Error('réseau')); },
                ontimeout: function () { reject(new Error('délai dépassé')); }
            });
        });
    }

    async function chargerDonnees() {

        const auth = GITHUB.token ? { 'Authorization': 'Bearer ' + GITHUB.token } : {};

        // 1) API GitHub : toujours à jour (limite de 60 lectures/heure
        //    sans token, largement suffisant ici).
        try {
            const texte = await requete(
                'https://api.github.com/repos/' + GITHUB.compte + '/' + GITHUB.depot +
                '/contents/' + GITHUB.fichier + '?ref=' + GITHUB.branche,
                Object.assign({ 'Accept': 'application/vnd.github.raw+json' }, auth)
            );
            return JSON.parse(texte);
        } catch (e) {
            console.warn('[Cartes Machines] API GitHub indisponible, essai du lien direct :', e.message);
        }

        // 2) Secours : lien direct (peut avoir quelques minutes de retard).
        const texte = await requete(
            'https://raw.githubusercontent.com/' + GITHUB.compte + '/' + GITHUB.depot +
            '/' + GITHUB.branche + '/' + GITHUB.fichier + '?t=' + Date.now(),
            auth
        );
        return JSON.parse(texte);
    }

    // =========================
    // SUPPRESSION D'UNE PRESSE (écriture sur GitHub)
    // =========================

    // L'écriture demande un token (droit "Contents : Read and write").
    // Soit il est écrit en haut du script (GITHUB.token), soit il est
    // saisi dans la pop-up à la première suppression et gardé par
    // Tampermonkey.
    function tokenEcriture() {
        return GITHUB.token || GM_getValue('tokenEcriture', '');
    }

    // Token refusé : on oublie celui gardé par Tampermonkey, ou on indique
    // de corriger celui écrit dans le script.
    function oublierToken() {
        if (GITHUB.token) return 'Vérifiez le token écrit en haut du script.';
        GM_setValue('tokenEcriture', '');
        return 'Saisissez-le à nouveau.';
    }

    function appelGitHub(methode, url, token, corps) {

        return new Promise(function (resolve, reject) {

            GM_xmlhttpRequest({
                method: methode,
                url: url,
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Accept': 'application/vnd.github+json',
                    'Content-Type': 'application/json',
                    'X-GitHub-Api-Version': '2022-11-28',
                    'Cache-Control': 'no-cache'
                },
                data: corps ? JSON.stringify(corps) : undefined,
                nocache: true,
                timeout: 20000,
                onload: function (r) { resolve({ status: r.status, texte: r.responseText }); },
                onerror: function () { reject(new Error('problème de réseau')); },
                ontimeout: function () { reject(new Error('GitHub ne répond pas')); }
            });
        });
    }

    function base64VersTexte(b64) {
        const binaire = atob(b64.replace(/\s/g, ''));
        const octets = Uint8Array.from(binaire, function (c) { return c.charCodeAt(0); });
        return new TextDecoder().decode(octets);
    }

    function texteVersBase64(texte) {
        const octets = new TextEncoder().encode(texte);
        let binaire = '';
        for (let i = 0; i < octets.length; i += 0x8000) {
            binaire += String.fromCharCode.apply(null, octets.subarray(i, i + 0x8000));
        }
        return btoa(binaire);
    }

    // Retire la presse de la liste ET de l'historique sur GitHub,
    // puis renvoie les données à jour.
    async function supprimerPresse(cle, nom, token) {

        const url = 'https://api.github.com/repos/' + GITHUB.compte + '/' + GITHUB.depot +
            '/contents/' + GITHUB.fichier;

        // Trois essais : si le téléphone a écrit entre la lecture et
        // l'écriture, GitHub refuse (conflit) et on recommence.
        for (let essai = 0; essai < 3; essai++) {

            // Adresse unique à chaque fois : évite qu'une réponse gardée en
            // cache (celle de l'affichage, dans un autre format) soit réutilisée.
            const lecture = await appelGitHub(
                'GET', url + '?ref=' + GITHUB.branche + '&_=' + Date.now(), token
            );

            if (lecture.status === 401) throw new Error('token refusé. ' + oublierToken());
            if (lecture.status === 404) throw new Error('fichier introuvable : le token a-t-il accès au dépôt ' + GITHUB.depot + ' ?');
            if (lecture.status !== 200) throw new Error('lecture impossible (erreur ' + lecture.status + ')');

            let fichier;
            try { fichier = JSON.parse(lecture.texte); } catch (e) { fichier = null; }

            if (!fichier || typeof fichier.content !== 'string' || !fichier.sha) {
                throw new Error('réponse inattendue de GitHub, réessayez dans un instant');
            }

            const contenu = JSON.parse(base64VersTexte(fichier.content));

            contenu.presses = contenu.presses || {};
            delete contenu.presses[cle];
            contenu.historique = (contenu.historique || []).filter(function (h) { return h.cle !== cle; });

            const ecriture = await appelGitHub('PUT', url, token, {
                message: 'Suppression ' + nom,
                content: texteVersBase64(JSON.stringify(contenu, null, 2) + '\n'),
                sha: fichier.sha,
                branch: GITHUB.branche
            });

            if (ecriture.status === 200 || ecriture.status === 201) return contenu;
            if (ecriture.status === 409 || ecriture.status === 422) continue;

            if (ecriture.status === 401 || ecriture.status === 403) {
                throw new Error('ce token n\'a pas le droit d\'écrire. ' + oublierToken());
            }

            throw new Error('écriture impossible (erreur ' + ecriture.status + ')');
        }

        throw new Error('conflit avec une autre modification, réessayez');
    }

    // --- Panneau de confirmation intégré à la pop-up --------------------

    function demanderSuppression(cle) {
        const p = donnees && donnees.presses && donnees.presses[cle];
        confirmation = { cle: cle, nom: (p && p.presse) || cle, occupe: false, erreur: '' };
        rendre();
    }

    async function confirmerSuppression(tokenSaisi) {

        const c = confirmation;
        if (!c || c.occupe) return;

        let token = tokenEcriture();

        if (!token) {
            token = (tokenSaisi || '').trim();
            if (!token) {
                c.erreur = 'Collez le token GitHub pour continuer.';
                rendre();
                return;
            }
        }

        c.occupe = true;
        c.erreur = '';
        rendre();

        try {
            donnees = await supprimerPresse(c.cle, c.nom, token);

            // Token saisi dans la pop-up et accepté : on le garde.
            if (!GITHUB.token && tokenSaisi) GM_setValue('tokenEcriture', token);

            confirmation = null;
            if (vue === 'detail') vue = 'liste';
            notifier(c.nom + ' supprimée');

        } catch (e) {
            console.error('[Cartes Machines]', e);
            c.occupe = false;
            c.erreur = 'Suppression impossible : ' + e.message;
            rendre();
        }
    }

    // Petit bandeau de confirmation en bas de la pop-up.
    function notifier(texte) {
        notification = texte;
        rendre();
        clearTimeout(notifier.minuterie);
        notifier.minuterie = setTimeout(function () {
            notification = '';
            rendre();
        }, 3000);
    }

    // =========================
    // OUTILS
    // =========================

    function ilYA(dateIso) {

        if (!dateIso) return '';

        const secondes = Math.round((Date.now() - new Date(dateIso).getTime()) / 1000);

        if (secondes < 60) return 'à l\'instant';
        if (secondes < 3600) return 'il y a ' + Math.floor(secondes / 60) + ' min';
        if (secondes < 86400) return 'il y a ' + Math.floor(secondes / 3600) + ' h';

        return new Date(dateIso).toLocaleString('fr-FR', {
            day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'
        });
    }

    function el(tag, classe, texte) {
        const e = document.createElement(tag);
        if (classe) e.className = classe;
        if (texte !== undefined) e.textContent = texte;
        return e;
    }

    function derniereCarte(donnees) {

        if (!donnees) return null;

        if (Array.isArray(donnees.historique) && donnees.historique.length) {
            return donnees.historique[0];
        }

        const liste = Object.keys(donnees.presses || {}).map(function (cle) {
            return Object.assign({ cle: cle }, donnees.presses[cle]);
        });

        liste.sort(function (a, b) { return (b.date || '').localeCompare(a.date || ''); });

        return liste[0] || null;
    }

    // =========================
    // INTERFACE (isolée de la page dans un Shadow DOM)
    // =========================

    const hote = document.createElement('div');
    hote.setAttribute('data-cartes-machines', '');
    hote.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:2147483647;';
    document.body.appendChild(hote);

    const racine = hote.attachShadow({ mode: 'open' });

    const style = document.createElement('style');
    style.textContent = `
        * { box-sizing: border-box; }
        :host { all: initial; }
        .pop {
            width: 310px; max-width: calc(100vw - 32px);
